    "lint": "next lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@vercel/blob": "^2.8.2",
    "fflate": "^0.8.3",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
