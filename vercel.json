{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/gc",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "src/app/api/uploads/[id]/commit/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/cron/gc/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
