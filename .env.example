# ---------------------------------------------------------------- storage ----
# Leave BLOB_READ_WRITE_TOKEN empty for local development: files go to
# ./.erfa3ly-data/blobs and survive restarts. On Vercel, connect a Blob store and
# the token is injected automatically — the storage driver then becomes "blob".
BLOB_READ_WRITE_TOKEN=

# Local-only: where uploads and the PGlite database live.
ERFA3LY_DATA_DIR=./.erfa3ly-data

# ---------------------------------------------------------------- database ---
# Postgres connection string (Neon, Supabase, RDS, ...). Required in production.
# The Vercel/Neon integrations may name it POSTGRES_URL or DATABASE_URL_UNPOOLED
# instead; all of those are accepted (pooled names preferred), so whichever the
# dashboard gives you can be pasted as-is.
# Empty locally → an in-process Postgres (PGlite, wasm) is created under
# $ERFA3LY_DATA_DIR/pgdata, running the exact same SQL as production.
DATABASE_URL=

# TLS for Postgres. Usually inferred from the connection string:
#   sslmode=disable/allow → no TLS, verify-full/verify-ca → certificate check,
#   require/prefer/unset → TLS without certificate check (what most providers
#   hand you), loopback host → no TLS.
# Pin it explicitly only when a provider's certificate setup needs it:
#   ERFA3LY_DB_SSL=verify-full | require | disable
ERFA3LY_DB_SSL=

# ---------------------------------------------------------------- logging ----
# off | error | warn | info | debug  (default: error)
# debug prints one JSON line per step with a request id: which version resolved,
# which storage keys were probed, how many bytes were injected or streamed, how
# long it took, and why a decision was made. Every preview response carries
# x-erfa3ly-request-id so a log line can be matched to a browser request.
# The dashboard's "Preview diagnosis" panel needs no setting to work.
ERFA3LY_LOG=error

# ----------------------------------------------------- preview delivery mode ---
# HTML larger than this is not rewritten in memory (no <base>/shim injection).
ERFA3LY_MAX_INLINE_BYTES=8388608
# Assets at least this large are redirected to Blob storage when it has a URL,
# so they never consume a function invocation. Set ERFA3LY_DIRECT_ASSETS=off to
# keep every byte same-origin (and lose that saving).
ERFA3LY_ASSET_REDIRECT_MIN_BYTES=1048576
ERFA3LY_DIRECT_ASSETS=on
# How much of a document the diagnosis scans (the head is enough).
ERFA3LY_DIAGNOSE_PREFIX_BYTES=2097152

# --------------------------------------------------------------- behaviour ---
# Bytes a single owner may store in total. Keep it under the storage plan
# (Vercel Blob Hobby: 1 GB). Default 900 MB leaves room for metadata.
ERFA3LY_QUOTA_BYTES=943718400
# Largest single file accepted. Vercel Blob allows 5 TB with multipart, but a
# share link nobody can open is not a feature: keep this human.
ERFA3LY_MAX_FILE_BYTES=104857600
# Largest version (all files summed) accepted.
ERFA3LY_MAX_VERSION_BYTES=524288000
# Largest number of files in one version (a static build is rarely >2k files).
ERFA3LY_MAX_FILES=2000
# Upload sessions that never commit are garbage collected after this long.
ERFA3LY_SESSION_TTL_HOURS=24
# Soft-deleted sites keep their bytes this long before the GC purges them.
ERFA3LY_DELETED_RETENTION_DAYS=7
# Write operations allowed per owner per hour (uploads + publishes).
ERFA3LY_RATE_LIMIT_PER_HOUR=60
# Optional but recommended: a second hostname pointing at this same deployment,
# used only for previews, e.g. https://artifacts.example.com
# With it, artifacts get a real origin (localStorage, indexedDB, history work)
# while carrying none of this app's cookies. Without it, previews stay sandboxed
# in an opaque origin and pages that need those APIs render blank.
ERFA3LY_PREVIEW_ORIGIN=

# Optional: comma-separated hosts allowed to reach the write API in addition to
# the deployment's own host. Normally empty.
ERFA3LY_ALLOWED_ORIGINS=
# Optional: shared secret for /api/cron/*. Vercel Cron sends it as a bearer token.
CRON_SECRET=
