{
  "name": "erfa3ly",
  "version": "0.1.0",
  "private": true,
  "description": "Erfa3ly — self-hosted publisher for AI-generated HTML, static sites, ZIPs, PDFs and documents, with sandboxed previews and share links.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build --webpack",
